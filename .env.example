NEXT_PUBLIC_APP_URL=http://localhost:3000
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
# Server only. Never prefix these keys with NEXT_PUBLIC_.
SUPABASE_SERVICE_ROLE_KEY=
RESEND_API_KEY=
BREVO_API_KEY=
PAYSTACK_SECRET_KEY=
# Paystack webhooks use PAYSTACK_SECRET_KEY for HMAC verification.
# Enable only after migration 009, HTTPS origin, provider and webhook setup.
EMAIL_DELIVERY_ENABLED=false
# Independent random secrets, at least 32 characters each.
EMAIL_WORKER_SECRET=
BREVO_WEBHOOK_SECRET=
# Signing secret from the Resend webhook dashboard.
RESEND_WEBHOOK_SECRET=

# Optional operator-run database backup, never used by browser code.
DATABASE_URL=
BACKUP_DIRECTORY=
